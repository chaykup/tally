# Copy to .env (never commit .env).
#
# Local Docker needs nothing here: docker-compose.yml already sets each service's
# DATABASE_URL and a dev JWT_SECRET. Set JWT_SECRET only to override that default.
# In production use a long random value (at least 32 bytes), the same in every service:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Supabase (production). Each service gets its own login; see the top of db/ddl.sql.
# Through Supabase's pooler the username is <login>.<project-ref>.
# AUTH_DATABASE_URL=postgresql://tally_auth.<project-ref>:<password>@<pooler-host>:5432/postgres
# INVENTORY_DATABASE_URL=postgresql://tally_inventory.<project-ref>:<password>@<pooler-host>:5432/postgres
# TRANSACTIONS_DATABASE_URL=postgresql://tally_transactions.<project-ref>:<password>@<pooler-host>:5432/postgres
# ANALYTICS_DATABASE_URL=postgresql://tally_analytics.<project-ref>:<password>@<pooler-host>:5432/postgres
